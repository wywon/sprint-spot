// SPOT — lib/types.ts 를 옮긴 것
// ★ 필드 이름은 lib/types.ts 와 같아야 한다. 바꾸면 화면 41개를 다시 고쳐야 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * ── enum ── lib/types.ts 의 유니온 타입 그대로 ────────────
 */

/// 센서가 판단한 결과. offline·manual·disabled·ev 는 저장하지 않는다.
/// 그건 SlotView(파생 상태)이고 lib/status.ts 의 slotStatus() 가 계산한다.
enum SlotStatus {
  available
  occupied
  unknown
}

/// ParkingSlot.type — 'ev' | 'disabled' | null
enum SlotType {
  ev
  disabled
}

enum TableStatus {
  available
  occupied
  reserved
  cleaning
  disabled
}

enum SensorState {
  online
  offline
}

/// Reservation(손님) + AdminReservation(관리자) 를 한 벌로 합쳤다.
///
/// [a7] 승인제로 바꾸면서 pending 과 rejected 를 넣었다.
///   예전에는 손님이 누르는 순간 곧바로 upcoming(확정)이었다.
///   실제 식당은 그렇게 굴러가지 않는다. 그 시간에 자리를 뺄 수 있는지,
///   그 인원을 받을 수 있는지는 매장만 안다. 확정을 매장이 하게 바꿨다.
///
///   pending  → 손님이 요청함. 매장 확인 대기. 아직 자리를 잡아 둔 상태가 아니다
///   upcoming → 매장이 승인함. 이제부터 진짜 예약이다
///   rejected → 매장이 거절함. canceled 와 반드시 구분한다.
///              손님이 마음을 바꾼 것과 매장이 못 받는 것은 다른 사건이고,
///              노쇼율·취소율 통계에서 섞이면 매장 평가가 왜곡된다
enum ReservationStatus {
  pending
  upcoming
  rejected
  seated
  done
  noshow
  canceled
}

enum LogTone {
  ok
  warn
  busy
  brand
  off
}

/**
 * ── 매장 ── PartnerStore + PlainStore 를 한 모델로 ────────
 */

model Store {
  id      String  @id // 's1' 'p1' — seed 가 직접 넣는다
  partner Boolean
  name    String
  cat     String
  lat     Float // 목업 지도 좌표 0~100
  lng     Float

  // ↓ partner = true 인 매장만 채운다 (PlainStore 는 전부 null)
  addr    String?
  tel     String?
  open    String?
  price   String?
  rating  Float       @default(0)
  reviews Int         @default(0) // ★ 리뷰 '개수'. 관계가 아니다
  tags    String[]    @default([])
  hero    String?
  sensor  SensorState @default(online)

  tablesUpdated  DateTime?
  parkingFee     String? // 구 parking.fee
  parkingUpdated DateTime? // 구 parking.updated

  tables       StoreTable[]
  slots        ParkingSlot[] // 구 parking.slots
  menus        Menu[]
  reservations Reservation[]
  reviewList   Review[] // ★ 관계 필드. 위 reviews(Int) 와 이름이 겹치면 안 된다
  logs         ActivityLog[]
  sensorLogs   SensorLog[]

  @@index([partner])
}

/**
 * ── 주차면 ───────────────────────────────────────────────
 */

model ParkingSlot {
  id      String @id @default(cuid()) // ★ types.ts 에 없던 필드. 아래 설명 참조
  storeId String
  code    String // 'A1' — 손님 화면에 노출하지 않는다
  row     Int
  col     Int
  zone    String

  /// 센서(D)만 쓴다
  autoStatus   SlotStatus  @default(unknown)
  /// 센서가 이 면을 마지막으로 보고한 시각. 60초 넘으면 화면이 offline 으로 그린다
  lastSeenAt   DateTime?
  /// 관리자(B)만 쓴다
  manualStatus SlotStatus?
  /// 지나면 자동으로 센서 값으로 돌아간다
  manualUntil  DateTime?
  manualBy     String?

  type       SlotType?
  nearGate   Boolean   @default(false)
  confidence Float     @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code]) // 같은 매장에 A1 이 둘일 수 없다
  @@index([storeId])
}

/**
 * ── 테이블 ───────────────────────────────────────────────
 */

model StoreTable {
  id      String      @id @default(cuid()) // ★ 구 't1' 은 code 로 내려갔다
  storeId String
  code    String // 't1' — 매장 안에서만 유일하다
  seats   Int
  status  TableStatus @default(available)
  row     Int
  col     Int
  w       Int         @default(1) // 배치도에서 차지하는 칸 수

  guest      Int?
  since      String? // '12:04'
  cleaningAt DateTime? // 40초 뒤 자동 available

  resAt    String? // '12:30'
  resName  String?
  resParty Int?

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([storeId, code])
  @@index([storeId])
}

/**
 * ── 대표 메뉴 ── mock 의 MENUS 가 전 매장 공용이라 매장별로 분리 ──
 */

model Menu {
  id      String @id @default(cuid())
  storeId String
  name    String
  price   String // '14,000' — mock 형식 유지
  order   Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/**
 * ── 공영주차장 ───────────────────────────────────────────
 */

model PublicLot {
  id        String   @id // 'L1'
  name      String
  gu        String
  addr      String
  type      String // '노외'
  total     Int
  available Int
  fee       String
  dayMax    String
  hours     String
  tel       String
  lat       Float
  lng       Float
  updated   DateTime @default(now())
  near      Json // [['s1',260], ['p1',180]] 그대로
}

/**
 * ── 예약 ── Reservation + AdminReservation 통합 ──────────
 */

model Reservation {
  id      String  @id @default(cuid())
  storeId String
  tableId String? // 예약 시점엔 null. 관리자가 입장시킬 때 채운다

  date     String // '2026-08-24'
  time     String // '12:30'
  party    Int
  seatType String
  /// [a7] 기본값이 pending 이다. 확정은 관리자가 승인을 눌러야 생긴다
  status   ReservationStatus @default(pending)

  name  String
  phone String
  memo  String @default("")

  /// [a7] 거절 사유 코드. lib/tokens.ts 의 REJECT_REASONS 키를 그대로 쓴다.
  /// 문구를 DB 에 넣지 않는 이유 — 문구는 바뀐다. 코드로 두면 나중에 표현만 고치면 된다
  rejectReason String?
  /// [a7] 매장이 승인·거절을 누른 시각. 손님 앱이 "새로 결정된 건"을 가려내는 데 쓴다
  decidedAt    DateTime?

  parkingAlert Boolean @default(false)
  exited       Boolean @default(false)
  receipt      Boolean @default(false) // 영수증 올렸는가 → 리뷰쓰기 활성 조건
  receiptPath  String?                 // Storage 경로. 예: "cmxxx.../1725900000000.jpg"
  receiptAt    DateTime?               // 올린 시각 (KST 보정된 값)
  reviewed     Boolean @default(false)

  createdAt DateTime @default(now())

  store  Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table  StoreTable? @relation(fields: [tableId], references: [id])
  review Review?


  @@unique([storeId, date, time, phone]) // 같은 사람이 같은 시간에 두 번 못 잡는다
  @@index([phone]) // GET /api/reservations?phone=
  @@index([storeId, date]) // 관리자 예약 달력
}

/**
 * ── 리뷰 ─────────────────────────────────────────────────
 */

model Review {
  id            String   @id @default(cuid())
  storeId       String
  reservationId String?  @unique // 방문 1건당 리뷰 1개
  name          String // '김**'
  rating        Int
  text          String
  createdAt     DateTime @default(now()) // 구 date('3일 전') → agoText() 로 만든다

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([storeId])
}

/**
 * ── 관리자 로그 ── 구 LogEntry ───────────────────────────
 */

model ActivityLog {
  id      String   @id @default(cuid())
  storeId String
  at      DateTime @default(now()) // 구 t
  who     String // '센서' | '최영호' | '시스템'
  msg     String
  tone    LogTone

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, at])
}

/**
 * — 센서 감지 로그 ——————————————————
 * 관리자 '센서 감지·변경 로그' 화면이 읽는다.
 * POST /api/detect 가 값을 받을 때마다 한 줄씩 쌓는다.
 */
model SensorLog {
  id         String     @id @default(cuid())
  storeId    String
  /// 'A1' — ParkingSlot.code
  slotCode   String
  status     SlotStatus
  /// 센서가 감지한 시각 (D가 보낸 값, 없으면 서버 도착 시각)
  detectedAt DateTime
  createdAt  DateTime   @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}
