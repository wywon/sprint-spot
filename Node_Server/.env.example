# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 본인 값을 채우세요.
# .env 는 깃에 올라가지 않습니다.

# 메인 아두이노(UNO #4)가 연결된 COM 포트. PC마다 다릅니다.
# 확인: npm run ports
SERIAL_PORT=COM10
BAUD_RATE=9600

# Express 서버 포트
PORT=3000

# Oracle 접속 정보
DB_USER=parking
DB_PASSWORD=
DB_CONNECT_STRING=localhost:1521/XEPDB1

# ------------------------------------------
# 우리 서버의 POST 보호 (선택)
# 값을 넣으면 POST 할 때 x-api-token 헤더에 같은 값을 보내야 합니다.
# 비워두면 누구나 POST 할 수 있습니다. GET 은 영향 없습니다.
# ------------------------------------------
API_TOKEN=

# ------------------------------------------
# SPOT 서버로 전송 (앱 팀 서버)
#
# 주차 상태가 바뀔 때마다, 그리고 1분에 한 번은 무조건 POST 를 보냅니다.
# 하트비트를 안 보내면 SPOT 서버가 "센서 오프라인" 으로 판단합니다.
#
# SPOT_URL 을 비워두면 이 기능이 완전히 꺼집니다.
# SPOT 서버가 꺼져 있거나 키가 틀려도 우리 서버는 죽지 않습니다.
# ------------------------------------------
SPOT_URL=https://sprint-spot.vercel.app/api/detect

# 팀에서 공유한 키. 없으면 401 이 납니다.
SPOT_KEY=

# 가게 식별자. 대흥동 손칼국수 = s1
SPOT_STORE_ID=s1

# 너무 자주 보내지 않도록 하는 최소 간격 (밀리초)
# 3000 이면 최악의 경우에도 시간당 1,200회를 넘지 않습니다.
SPOT_MIN_INTERVAL_MS=3000

# 변화가 없어도 이 간격마다 한 번은 보냅니다 (밀리초)
SPOT_HEARTBEAT_MS=60000

# SPOT 서버 응답을 기다리는 최대 시간 (밀리초)
# 실측 0.15초 (서울 리전). 느려질 때를 대비해 여유를 둡니다.
SPOT_TIMEOUT_MS=10000
